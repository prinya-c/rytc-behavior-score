rules_version = '2';

// These rules apply to the "behavior-score" named Firestore database only
// (see firebase.json). The "out-of" database is a separate, pre-existing
// database owned by another system — this app never writes to it, and these
// rules make no claim over it; its own rules are managed elsewhere.
//
// This app does NOT use Firebase Auth (by explicit product decision), so
// there is no request.auth to check identity against. That means these
// rules CANNOT enforce "only the account owner can write their own score"
// or "only registered teachers can write" — any client holding the public
// Firebase config (which is unavoidably public for a web app) can read/write
// `student-scores` and `teacher-accounts`. Passwords are hashed (see
// src/lib/passwordHash.js) so a leaked account collection doesn't expose
// plaintext passwords, but this is browser-side gating only, not database-
// level access control. See README.md for the accepted-risk discussion.
service cloud.firestore {
  match /databases/{database}/documents {
    match /student-scores/{docId} {
      allow read, write: if true;
    }

    match /teacher-accounts/{docId} {
      allow read, write: if true;
    }
  }
}
